# Copy to .env.local and fill in real values. These are build-time variables
# (NEXT_PUBLIC_* are inlined into the static export, so they must not be secret
# beyond what a public static site can safely expose).

# Contact form delivery: get a free public access key at https://web3forms.com
# (enter the Gmail address that should receive messages). Without this key the
# contact form falls back to opening the visitor's email client via mailto:.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Sub-path when deploying to a GitHub Pages project site, e.g. /Portfolio-Website.
# Leave empty for apex/custom domains and Vercel.
NEXT_PUBLIC_BASE_PATH=

# Canonical public URL of the deployment (used for Open Graph, sitemap, robots).
# If unset, it is derived from NEXT_PUBLIC_BASE_PATH:
#   https://aniketdede.github.io<NEXT_PUBLIC_BASE_PATH>
NEXT_PUBLIC_SITE_URL=
