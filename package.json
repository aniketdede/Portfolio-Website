{
  "name": "aniket-dede-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "optimize-images": "node scripts/optimize-images.mjs",
    "e2e": "node scripts/e2e-static.mjs",
    "e2e:pages": "node scripts/e2e-static.mjs /Portfolio-Website",
    "deploy:pages": "npx cross-env NEXT_PUBLIC_BASE_PATH=/Portfolio-Website next build && node -e \"require('fs').writeFileSync('out/.nojekyll', '')\" && gh-pages --dotfiles -d out -b gh-pages -r https://github.com/aniketdede/Portfolio-Website.git"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "gh-pages": "^6.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4"
  }
}
